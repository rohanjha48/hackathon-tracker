# ==============================================================================
# 🚀 HACKTRACK ENVIRONMENT VARIABLES (100% FREE SERVERLESS TIER)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Free Database & API)
# Get these from: https://supabase.com -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key is secret and ONLY used in backend cron scripts & admin API
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. Telegram Bot API (100% Free Unlimited Delivery)
# Create a bot in 30 seconds:
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot and follow prompt to pick a name and username
# 3. Copy the HTTP API token given by BotFather and paste below:
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ_sample

# Optional: Default target channel ID if broadcasting to a Telegram public channel
TELEGRAM_CHANNEL_ID=@your_hackathon_channel
